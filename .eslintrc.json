{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "plugins": [
    "react"
  ],
  "rules": {
    "no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": true,
        "variables": true
      }
    ],
    "no-undef": "error",
    "react/jsx-uses-vars": "error",
    "react/jsx-uses-react": "off",
    "react/jsx-no-undef": "error"
  }
}
